```gitignore
# Python cache files
__pycache__/
*.py[cod]
*.pyo

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
env/
.venv/

# Python environment files
.env
.env.*

# IDE settings
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.log
*.tmp
```
